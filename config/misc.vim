
" Syntax highlighting
syntax on

" Enable line numbers
set number

" Relative line number
set relativenumber


set tabstop=4      " Visual width of a hard tab
set shiftwidth=4   " Size of an indent level
set softtabstop=4  " Number of spaces a tab counts for while editing
set expandtab      " Turn tabs into spaces


" Show top tabline
set showtabline=2
